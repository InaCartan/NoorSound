<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NoorSound.AppShell"
    
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    
    xmlns:local="clr-namespace:NoorSound"
    xmlns:views="clr-namespace:NoorSound.Views"
    
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#0F0E0B"
    Shell.TabBarForegroundColor="#E3BD5A"
    Shell.TabBarTitleColor="#E3BD5A"
    Shell.TabBarUnselectedColor="#8F8873"
    
    Title="NoorSound">

    <!-- Login & SignUp -->
    <ShellContent
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent
        Route="SignUpPage"
        ContentTemplate="{DataTemplate views:SignUpPage}" />



    <TabBar>

        <!-- Home -->
        <ShellContent
            Title="Home"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage"/>

        <!-- Library -->
        <ShellContent
            Title="Library"
            Icon="tab_library.png"
            ContentTemplate="{DataTemplate views:LibraryPage}"
            Route="LibraryPage"/>

        <!-- Search -->
        <ShellContent
            Title="Search"
            Icon="tab_search.png"
            ContentTemplate="{DataTemplate views:SearchPage}"
            Route="SearchPage/"/>



    </TabBar>

</Shell>
