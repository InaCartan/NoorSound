<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             
             x:Class="NoorSound.Views.AudioPlayerPage"
             Title="">
    
    <VerticalStackLayout>
        <Label 
            Text="BismiIllah Ar-Rahmaan Ar-Raheem"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Image
        Source="{Binding CurrentAudio.ImageUrl}"
        HeightRequest="300" />

        <Label
        Text="{Binding CurrentAudio.AudioName}"
        FontSize="24"
        HorizontalOptions="Center" />

        <Label
        Text="{Binding CurrentAudio.Admin.Name}"
        HorizontalOptions="Center" />

        
        <toolkit:MediaElement
        Source="{Binding CurrentAudio.AudioUrl}"
        ShouldShowPlaybackControls="True"
        HeightRequest="100" />

    </VerticalStackLayout>
</ContentPage>