<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             xmlns:viewmodel="clr-namespace:NoorSound.ViewModels"
             x:DataType="viewmodel:PlaylistViewModel"
             xmlns:model="clr-namespace:NoorSound.Models"

             x:Class="NoorSound.Views.PlaylistPage"
             Title="{Binding PlaylistName}">

    <CollectionView Margin="20"
                    ItemsSource="{Binding Audios}">

        <CollectionView.ItemsLayout>
            <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
        </CollectionView.ItemsLayout>

        <CollectionView.EmptyView>
            <Label Text="This playlist has no audios yet."
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="model:Audio">
                <Border
                    Padding="12"
                    Background="#601d2021"
                    Stroke="Dimgray"
                    StrokeThickness="2">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10,10,10,10" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image
                            Grid.Column="0"
                            Aspect="AspectFill"
                            HeightRequest="60"
                            WidthRequest="60"
                            Source="{Binding ImageUrl}" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="Medium"
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Text="{Binding AudioName}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>