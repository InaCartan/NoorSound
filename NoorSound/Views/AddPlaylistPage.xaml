<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             
             xmlns:viewmodel="clr-namespace:NoorSound.ViewModels"
             x:DataType="viewmodel:AddPlaylistViewModel"
             xmlns:model="clr-namespace:NoorSound.Models"
             
             x:Class="NoorSound.Views.AddPlaylistPage"
             Title="Add Playlist">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Name of playlist" FontAttributes="Bold" />
            <Entry Placeholder="Enter the name of the playlist"
                   Text="{Binding NewPlaylistName}" />
            

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>