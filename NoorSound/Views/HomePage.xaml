<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             
             x:Class="NoorSound.Views.HomePage"
             x:Name="homePage"
             Title="Home"
             
             xmlns:model="clr-namespace:NoorSound.Models"
             xmlns:viewmodel="clr-namespace:NoorSound.ViewModels"       

             x:DataType="viewmodel:HomeViewModel">

    <CollectionView ItemsSource="{Binding Audios}">

        <CollectionView.Header>
            <Label Text="Profil" FontAttributes="Bold">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                    Command="{Binding Source={x:Reference homePage}, Path=BindingContext.NavProfilePageCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </CollectionView.Header> 
            
            <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="model:Audio">

                <VerticalStackLayout Padding="10">
                    <Image Source="{Binding ImageUrl}" HeightRequest="200">

                        <Image.GestureRecognizers>
                            <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:HomeViewModel}}, Path=NavAudioPlayerPageCommand}"
                            CommandParameter="{Binding .}" />
                        </Image.GestureRecognizers>

                    </Image>

                    <Label Text="{Binding AudioName}" FontAttributes="Bold" />

                    <Label Text="{Binding Admin.Name}" FontSize="12" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>