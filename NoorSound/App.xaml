<?xml version = "1.0" encoding = "UTF-8" ?>
<Application x:Class="NoorSound.App"
             xmlns:local="clr-namespace:NoorSound"
             xmlns:views="clr-namespace:NoorSound.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Used by AddAudioPage and AddPlaylistPage -->
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />

            <ControlTemplate x:Key="PageWithMiniPlayer">
                <Grid RowDefinitions="*,Auto" RowSpacing="0">
                    <ContentPresenter Grid.Row="0" />
                    <views:MiniPlayerView Grid.Row="1" />
                    <views:PlayerSheetView Grid.Row="0" Grid.RowSpan="2" />
                </Grid>
            </ControlTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
